# Copy to `.env`, paste your Neon connection string, then run: npm run db:setup
#
# 1. https://neon.tech → New Project → copy "Connection string" (PostgreSQL)
# 2. Paste below, then: npm run db:setup   (creates PublishedIsland table)
# 3. Vercel → global-beit-midrash → Settings → Environment Variables:
#    DATABASE_URL = same string (Production + Preview)
#    Then redeploy. On Neon/Vercel integration, DATABASE_URL may be added for you.
#
# User "posts" = published islands (group name, choices, reflection) via /api/published-islands

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"
